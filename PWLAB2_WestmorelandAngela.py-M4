# This program uses a dictionary to store vehicle MPG and calculate gas needed

cars_dict = {
    "Camaro": 18.21,
    "Prius": 52.36,
    "Model S": 110,
    "Silverado": 26
}

keys = cars_dict.keys()
print(keys)
print()

vehicle = input("Enter a vehicle to see it's mpg: ")
print()

mpg = cars_dict[vehicle]
print("The " + vehicle + " gets " + str(mpg) + " mpg.")
print()

miles = float(input("How many miles will you drive the " + vehicle + "? "))
print()

gallons = miles / mpg

print(f"{gallons:.2f} gallon(s) of gas are needed to drive the {vehicle} {miles:.1f} miles.")